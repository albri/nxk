{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_nxk_nxk__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" hooks/asked.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" hooks/stop-check.ts"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^nxk:(second-look|researcher|panel)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" hooks/stop-check.ts"
          }
        ]
      }
    ]
  }
}
